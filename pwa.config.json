{
  "id": "sg16children",
  "domain": "sg16children.com",
  "manifest_id": "https://sg16children.com/",
  "name": "SG16 Children World",
  "short_name": "SG16 Kids",
  "description": "Play · Learn · Grow — safe AI learning for kids and families.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#dceeff",
  "theme_color": "#5eb8ff",
  "categories": ["education", "kids", "family"],
  "icon_source": "assets/sg16-children-world-logo.jpg",
  "icons_dir": "assets/icons",
  "icon_background": "#dceeff",
  "version": 12,
  "precache": [
    "/",
    "/app/",
    "/css/home.css",
    "/js/home-resume.js",
    "/manifest.webmanifest",
    "/assets/home-hero.jpg",
    "/assets/sg16-children-world-logo.jpg",
    "/assets/robo.jpeg",
    "/assets/robo.mp4",
    "/assets/robo_idle.mp4",
    "/assets/robo_thinking.mp4",
    "/assets/robo_happy.mp4",
    "/assets/icons/icon-192.png",
    "/assets/icons/icon-512.png"
  ],
  "shortcuts": [
    {
      "name": "Robo App",
      "short_name": "Robo",
      "description": "Open SG16 Children World Robo",
      "url": "/app/",
      "icon": "assets/icons/app-children.png"
    }
  ],
  "outputs": {
    "manifest": "manifest.webmanifest",
    "sw": "sw.js",
    "pwa_js": "js/pwa.js"
  }
}
